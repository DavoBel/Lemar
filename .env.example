# Copiar a .env y completar. NUNCA poner acá los valores reales:
# este archivo se commitea, .env no.

# --- Base de datos (Neon) ---
# POOLED: la usa la app en runtime. El host tiene que ver "-pooler" en el host
# de la URL. Con la directa, en un host que duerme el proceso, aparecen errores
# de conexión intermitentes.
DATABASE_URL="postgresql://usuario:contrasena@ep-algo-pooler.region.aws.neon.tech/basededatos?sslmode=require"
# DIRECTA: la usan las migraciones de Prisma (prisma migrate deploy).
DIRECT_URL="postgresql://usuario:contrasena@ep-algo.region.aws.neon.tech/basededatos?sslmode=require"

# --- Sesión ---
# Clave para firmar el JWT. Larga y distinta de la de desarrollo.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_JWT="poner-una-clave-larga-y-aleatoria"

# --- Entorno ---
# En producción tiene que decir exactamente "production": de eso depende que la
# cookie de sesión salga con secure: true.
NODE_ENV="development"
# El host suele imponer el suyo. server.js usa 3000 si no está.
PORT=3000

# --- CORS ---
# Orígenes del panel y del sitio, sin barra final. Si faltan, sólo quedan
# habilitados los localhost de desarrollo y en producción todo responde
# bloqueado por CORS.
URL_PANEL="https://panel.lemarautomoviles.com"
URL_SITIO="https://lemarautomoviles.com"

# --- Cloudinary (fotos de los vehículos) ---
# Sin esto la subida de fotos falla. Salen del Dashboard de Cloudinary.
CLOUDINARY_CLOUD_NAME="nombre-de-la-cuenta"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="clave-secreta-de-cloudinary"

# --- Aviso de consumo de Cloudinary ---
# Porcentaje de créditos usados a partir del cual el job de Actions falla a
# propósito para que GitHub mande el mail. Opcional: si falta, el script usa
# su valor por defecto.
UMBRAL_CONSUMO=60
